# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# collector (Python transport layer)
/collector/.venv/
__pycache__/
/data/crawls/
/data/logs/

# 외부 디자인 도구 작업 디렉터리 (배포 업로드 경량화)
/onlook/

